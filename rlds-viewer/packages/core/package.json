{
  "name": "@rlds-viewer/core",
  "version": "0.1.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "build": "tsdown"
  },
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "rlds-source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  }
}
