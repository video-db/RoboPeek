{
  "name": "@videodb/robopeek-mcap",
  "version": "0.1.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "build": "tsdown"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/video-db/RoboPeek.git",
    "directory": "packages/mcap"
  },
  "homepage": "https://github.com/video-db/RoboPeek#readme",
  "bugs": {
    "url": "https://github.com/video-db/RoboPeek/issues"
  },
  "description": "Read MCAP recordings (ROS 2, protobuf, JSON) in the browser, fetching only the chunks you play",
  "keywords": [
    "mcap",
    "ros2",
    "robotics",
    "foxglove",
    "dataset"
  ],
  "dependencies": {
    "@foxglove/rosmsg": "^5.0.5",
    "@foxglove/rosmsg-serialization": "^2.1.2",
    "@foxglove/rosmsg2-serialization": "^3.1.2",
    "@mcap/core": "^2.3.0",
    "fzstd": "^0.1.1",
    "lz4js": "^0.2.0",
    "protobufjs": "^8.8.0"
  },
  "devDependencies": {
    "@types/lz4js": "^0.2.2"
  },
  "exports": {
    ".": {
      "robopeek-source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  }
}
