{
  "name": "@videodb/robopeek-react",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19",
    "react-dom": "^19",
    "vitest-browser-react": "^2.3.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "robopeek-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./styles.css": {
      "robopeek-source": "./src/styles/styles.css",
      "default": "./dist/styles.css"
    },
    "./structure.css": {
      "robopeek-source": "./src/styles/structure.css",
      "default": "./dist/structure.css"
    },
    "./theme.css": {
      "robopeek-source": "./src/styles/theme.css",
      "default": "./dist/theme.css"
    }
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json",
      "./styles.css": "./dist/styles.css",
      "./structure.css": "./dist/structure.css",
      "./theme.css": "./dist/theme.css"
    },
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/video-db/RoboPeek.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/video-db/RoboPeek#readme",
  "bugs": {
    "url": "https://github.com/video-db/RoboPeek/issues"
  },
  "description": "React viewer and player components for RLDS robot-learning episodes",
  "keywords": [
    "rlds",
    "react",
    "robotics",
    "episode-viewer",
    "dataset"
  ],
  "dependencies": {
    "@videodb/robopeek-rlds": "workspace:^"
  }
}
