{
  "name": "@videodb/robopeek-react",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@videodb/robopeek-mcap": "workspace:^",
    "@videodb/robopeek-rlds": "workspace:^",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19",
    "react-dom": "^19",
    "vitest-browser-react": "^2.3.0"
  },
  "peerDependencies": {
    "@videodb/robopeek-mcap": ">=0.1.0 <1.0.0",
    "@videodb/robopeek-rlds": ">=0.2.0 <1.0.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "robopeek-source": "./src/core/index.ts",
      "default": "./dist/index.js"
    },
    "./mcap": {
      "robopeek-source": "./src/mcap/index.ts",
      "default": "./dist/mcap.js"
    },
    "./rlds": {
      "robopeek-source": "./src/rlds/index.ts",
      "default": "./dist/rlds.js"
    },
    "./package.json": "./package.json",
    "./styles.css": {
      "robopeek-source": "./src/styles/styles.css",
      "default": "./dist/styles.css"
    },
    "./structure.css": {
      "robopeek-source": "./src/styles/structure.css",
      "default": "./dist/structure.css"
    },
    "./theme.css": {
      "robopeek-source": "./src/styles/theme.css",
      "default": "./dist/theme.css"
    }
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./mcap": "./dist/mcap.js",
      "./rlds": "./dist/rlds.js",
      "./package.json": "./package.json",
      "./styles.css": "./dist/styles.css",
      "./structure.css": "./dist/structure.css",
      "./theme.css": "./dist/theme.css"
    },
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/video-db/RoboPeek.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/video-db/RoboPeek#readme",
  "bugs": {
    "url": "https://github.com/video-db/RoboPeek/issues"
  },
  "description": "React viewers, a composable player and hooks for robot-learning data (RLDS, MCAP)",
  "keywords": [
    "rlds",
    "react",
    "robotics",
    "episode-viewer",
    "dataset",
    "mcap"
  ],
  "peerDependenciesMeta": {
    "@videodb/robopeek-rlds": {
      "optional": true
    },
    "@videodb/robopeek-mcap": {
      "optional": true
    }
  }
}
